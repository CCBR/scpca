// Standalone profile for execution on the NIH Biowulf SLURM cluster.
process {
  executor = 'slurm'
  queue = 'norm'
  resourceLimits = [cpus: 24, memory: 224.GB]
  clusterOptions = '--gres=lscratch:200'
  scratch = '/lscratch/$SLURM_JOB_ID'
  stageInMode = 'symlink'
  stageOutMode = 'rsync'
  cache = 'deep'
}

executor.'$slurm'.queueSize = 200
executor.'$slurm'.pollInterval = '2 min'
executor.'$slurm'.queueStatInterval = '5 min'
executor.'$slurm'.submitRateLimit = '6/1min'

singularity {
  enabled = true
  autoMounts = true
  cacheDir = env('BIOWULF_SIF_CACHE')
  envWhitelist = 'SLURM_JOB_ID,SINGULARITY_BINDPATH'
}

docker.enabled = false
