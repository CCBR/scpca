def pipelinesHome = env('PIPELINES_HOME')
if (!pipelinesHome?.trim()) {
  throw new IllegalArgumentException('Set PIPELINES_HOME to the shared pipelines directory before running Nextflow')
}
def scpcaHome = "${pipelinesHome.replaceAll('/+$', '')}/scpca/v0.11.0"

params {
  ref_rootdir = "${scpcaHome}/references"
  barcode_dir = "${params.ref_rootdir}/barcodes/10X"
  probes_dir = "${params.ref_rootdir}/flex-probe-refs"
  flex_probeset_file = "${params.probes_dir}/Chromium_Human_Transcriptome_Probe_Set_v1.1.0_GRCh38-2024-A.csv"
  celltype_ref_dir = "${params.ref_rootdir}/celltype"
  singler_references_dir = "${params.celltype_ref_dir}/singler_references"
  singler_models_dir = "${params.celltype_ref_dir}/singler_models"
  cellassign_ref_dir = "${params.celltype_ref_dir}/cellassign_references"
  scimilarity_model_dir = "${params.celltype_ref_dir}/scimilarity_references/model_v1.1"
  salmon_container = "${scpcaHome}/images/salmon-1.9.0.sif"
  alevinfry_container = "${scpcaHome}/images/alevin-fry-0.7.0.sif"
  scpcatools_slim_container = "${scpcaHome}/images/scpcatools-slim-v0.4.6.sif"
  scpcatools_reports_container = "${scpcaHome}/images/scpcatools-reports-v0.4.6.sif"
  scpcatools_anndata_container = "${scpcaHome}/images/scpcatools-anndata-v0.4.6.sif"
  scvi_container = "${scpcaHome}/images/scvi-v0.11.0-gpu.sif"
}
